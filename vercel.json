{
  "version": 2,
  "github": {
    "silent": true
  },
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "installCommand": "echo 'skip install'",
  "buildCommand": "echo 'skip build'",
  "outputDirectory": "."
}