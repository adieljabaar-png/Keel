{
  "name": "KEEL \u2014 Steady by design",
  "short_name": "KEEL",
  "description": "Adaptive training companion with real-time Bluetooth health monitoring, live map with 5km hiking trails, public nearby users, and Apple Watch via HealthKit/Health Connect.",
  "start_url": "./#home",
  "scope": "./",
  "id": "keel-app",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui",
    "browser"
  ],
  "orientation": "portrait",
  "background_color": "#090A0C",
  "theme_color": "#090A0C",
  "lang": "en",
  "categories": [
    "health",
    "fitness",
    "lifestyle"
  ],
  "permissions": [
    "geolocation"
  ],
  "bluetooth": {
    "optional_services": [
      "heart_rate",
      "battery_service",
      "device_information",
      "0000180d-0000-1000-8000-00805f9b34fb",
      "generic_access"
    ]
  },
  "permissions_policy": {
    "geolocation": [
      "self"
    ],
    "bluetooth": [
      "self"
    ]
  },
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Start session",
      "short_name": "Start",
      "url": "./#home",
      "description": "Begin an adapted training session",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Live map",
      "short_name": "Live",
      "url": "./#live",
      "description": "Live map with trails within 5km",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Health profile",
      "short_name": "Profile",
      "url": "./#you",
      "description": "Your health + connected wearable data",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}